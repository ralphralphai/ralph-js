{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath", "parent", "sibling", "index"]
    ]
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/dist/",
    "packages/schema/src/generated/",
    "pnpm-lock.yaml",
    "**/*.json",
    "!package.json",
    "**/*.jsonc",
    "**/*.json5",
    // Prose, not code. oxfmt rewrites emphasis markers and re-pads tables, which
    // is pure churn on hand-written documents.
    "**/*.md"
  ]
}
