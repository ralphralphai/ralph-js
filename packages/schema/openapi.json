{
  "openapi": "3.1.0",
  "info": {
    "title": "Ralph",
    "description": "Multi-tenant ingestion for user-interaction analytics.",
    "license": {
      "name": "ISC",
      "identifier": "ISC"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "`GET /health` — readiness for the container orchestrator.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Server is up and the pool is reachable"
          }
        }
      }
    },
    "/v1/ingest": {
      "post": {
        "tags": [
          "ingest"
        ],
        "summary": "Accept one batch of interaction events.",
        "operationId": "ingest",
        "requestBody": {
          "description": "Columnar event batch, gzip-compressed. Send `Content-Encoding: gzip`.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Batch durably stored"
          },
          "400": {
            "description": "Malformed or invalid batch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown or revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds the compressed or decompressed limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Columns": {
        "type": "object",
        "required": [
          "dt",
          "ty"
        ],
        "properties": {
          "a": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "c": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "dt": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "px": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "py": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "rx": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "ry": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "s": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "sx": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "sy": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "tr": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "ty": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "u": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "The body of any non-2xx response.",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "A stable, machine-readable reason."
          },
          "message": {
            "type": "string",
            "description": "A human-readable detail. Safe to log; never echoes the payload."
          }
        }
      },
      "EventBatch": {
        "type": "object",
        "description": "One flush from the browser SDK or the native app SDK.\n\n`projectId` is deliberately absent: it is derived from the API key, so a\nclient cannot assert another tenant's project. `userId` necessarily *is*\nclient-asserted — there is no way around that for anonymous analytics, so it\nis mitigated with per-key rate limiting rather than pretended away.",
        "required": [
          "v",
          "userId",
          "sessionId",
          "t0",
          "tracks",
          "sizes",
          "n",
          "cols"
        ],
        "properties": {
          "appNavParams": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Interned navigation params, from the native app SDK, which has no urls\nto intern. `cols.a` indexes this.\n\nExactly one of the two tables is present, and which one is what says\nwhether a batch's events address `u` or `a`. That is why neither is\nrejected rather than read as \"no pages\": an SDK that stopped sending\nits table would otherwise be indistinguishable from a flush that\nlegitimately references none, which is every session's last one."
          },
          "buildId": {
            "type": [
              "string",
              "null"
            ]
          },
          "cols": {
            "$ref": "#/components/schemas/Columns"
          },
          "n": {
            "type": "integer",
            "format": "int32",
            "description": "Event count. Explicit rather than inferred from `dt.length`, so a\ntruncated or mismatched body fails validation instead of decoding\nshort.",
            "minimum": 0
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "sizes": {
            "type": "array",
            "items": {
              "type": "array",
              "items": false,
              "prefixItems": [
                {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                }
              ]
            },
            "description": "Interned viewport sizes as `[width, height]`. `cols.s` indexes this."
          },
          "t0": {
            "type": "integer",
            "format": "int64",
            "description": "Base epoch ms. Each event's `dt` is milliseconds since the previous\nevent, so absolute timestamps are recovered by a running sum from here."
          },
          "tracks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Interned `data-track-id`s. `[0]` is reserved and always `\"\"`, so `tr`\nof `0` means \"no tracked element\" by construction and `tr` of `k`\nis plainly `tracks[k]`. Reserving a slot puts that in the data\ninstead of making it a ±1 both decoders have to remember — and an\noff-by-one here would misattribute every click on whichever element\ninterned first, silently, rather than crashing."
          },
          "urls": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Interned absolute hrefs, from the browser SDK. `cols.u` indexes this."
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "SDK-generated anonymous UUID."
          },
          "v": {
            "type": "integer",
            "format": "int32",
            "description": "Format version.",
            "minimum": 0
          }
        }
      },
      "MouseMoveEvent": {
        "type": "object",
        "required": [
          "dt",
          "ty",
          "s",
          "px",
          "py"
        ],
        "properties": {
          "a": {
            "type": "integer"
          },
          "c": {
            "type": "integer"
          },
          "dt": {
            "type": "integer"
          },
          "px": {
            "type": "integer"
          },
          "py": {
            "type": "integer"
          },
          "s": {
            "type": "integer"
          },
          "ty": {
            "type": "integer",
            "enum": [
              8
            ]
          },
          "u": {
            "type": "integer"
          }
        }
      },
      "PageClickEvent": {
        "type": "object",
        "required": [
          "dt",
          "ty",
          "s",
          "px",
          "py"
