            "enum": [
              4
            ]
          },
          "u": {
            "type": "integer"
          }
        }
      },
      "PageViewEvent": {
        "type": "object",
        "required": [
          "dt",
          "ty",
          "s",
          "sx",
          "sy"
        ],
        "properties": {
          "a": {
            "type": "integer"
          },
          "c": {
            "type": "integer"
          },
          "dt": {
            "type": "integer"
          },
          "s": {
            "type": "integer"
          },
          "sx": {
            "type": "integer"
          },
          "sy": {
            "type": "integer"
          },
          "ty": {
            "type": "integer",
            "enum": [
              5
            ]
          },
          "u": {
            "type": "integer"
          }
        }
      },
      "PressableEvent": {
        "type": "object",
        "required": [
          "dt",
          "ty",
          "tr"
        ],
        "properties": {
          "dt": {
            "type": "integer"
          },
          "tr": {
            "type": "integer"
          },
          "ty": {
            "type": "integer",
            "enum": [
              1
            ]
          }
        }
      },
      "RalphEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/PressableEvent"
          },
          {
            "$ref": "#/components/schemas/PageClickEvent"
          },
          {
            "$ref": "#/components/schemas/PageViewEvent"
          },
          {
            "$ref": "#/components/schemas/SessionStartEvent"
          },
