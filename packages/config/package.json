{
  "name": "@ralphralphai/config",
  "version": "1.5.1",
  "description": "The configuration contract for Ralph: the rule types a ralph.jsonc declares, its JSON Schema, and the zod schemas both are generated from.",
  "license": "Apache-2.0",
  "author": "RalphRalph AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ralphralphai/ralph-js.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/ralphralphai/ralph-js/tree/main/packages/config#readme",
  "bugs": {
    "url": "https://github.com/ralphralphai/ralph-js/issues"
  },
  "keywords": [
    "ralph",
    "analytics",
    "crawler",
    "configuration",
    "types",
    "json-schema"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.mts",
        "default": "./dist/zod.mjs"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    },
    "./schema.json": "./schema/ralph.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "/dist",
    "/schema"
  ],
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "build": "pnpm generate && tsdown",
    "check": "pnpm generate && tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "json-schema-to-typescript": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
