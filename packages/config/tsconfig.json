{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Listed explicitly: tsc does not pick up the pnpm-linked `@types/node` on
    // its own, and `scripts/` plus the schema test read files.
    "types": ["node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "scripts"],
  "exclude": ["node_modules", "dist"]
}
